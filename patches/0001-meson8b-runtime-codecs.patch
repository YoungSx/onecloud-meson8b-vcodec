+#define QDCT_JPEG_QUANT_DATA	HREG(0x1f29)
+
+/* ENCODER_STATUS protocol (HENC_SCRATCH_0) */
+#define ENCODER_IDLE		0
+#define ENCODER_SEQUENCE	1
+#define ENCODER_PICTURE		2
+#define ENCODER_IDR		3
+#define ENCODER_NON_IDR		4
