+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Copyright (C) 2018 BayLibre, SAS
+ * Author: Maxime Jourdan <mjourdan@baylibre.com>
+ */
+
+#include <linux/gcd.h>
+#include <media/v4l2-mem2mem.h>
+#include <media/v4l2-event.h>
+#include <media/videobuf2-dma-contig.h>
+
+#include "vdec_helpers.h"
+#include "../runtime/meson8b-runtime.h"
+
+#define NUM_CANVAS_NV12 2
+#define NUM_CANVAS_YUV420 3
+
+u32 amvdec_read_dos(struct amvdec_core *core, u32 reg)
+{
+	return readl_relaxed(core->dos_base + reg);
+}
+EXPORT_SYMBOL_GPL(amvdec_read_dos);
+
+void amvdec_write_dos(struct amvdec_core *core, u32 reg, u32 val)
+{
+	writel_relaxed(val, core->dos_base + reg);
+}
+EXPORT_SYMBOL_GPL(amvdec_write_dos);
+
+void amvdec_write_dos_bits(struct amvdec_core *core, u32 reg, u32 val)
+{
+	if (core->platform->revision == VDEC_REVISION_MESON8B) {
+		meson8b_runtime_update_dos_bits(reg, val, val);
+		return;
+	}
+	amvdec_write_dos(core, reg, amvdec_read_dos(core, reg) | val);
+}
+EXPORT_SYMBOL_GPL(amvdec_write_dos_bits);
+
+void amvdec_clear_dos_bits(struct amvdec_core *core, u32 reg, u32 val)
+{
+	if (core->platform->revision == VDEC_REVISION_MESON8B) {
+		meson8b_runtime_update_dos_bits(reg, val, 0);
+		return;
+	}
+	amvdec_write_dos(core, reg, amvdec_read_dos(core, reg) & ~val);
+}
+EXPORT_SYMBOL_GPL(amvdec_clear_dos_bits);
+
+u32 amvdec_read_parser(struct amvdec_core *core, u32 reg)
+{
+	return readl_relaxed(core->esparser_base + reg);
+}
+EXPORT_SYMBOL_GPL(amvdec_read_parser);
+
+void amvdec_write_parser(struct amvdec_core *core, u32 reg, u32 val)
+{
+	writel_relaxed(val, core->esparser_base + reg);
+}
+EXPORT_SYMBOL_GPL(amvdec_write_parser);
+
+/* 4 KiB per 64x32 block */
+u32 amvdec_am21c_body_size(u32 width, u32 height)
+{
+	u32 width_64 = ALIGN(width, 64) / 64;
+	u32 height_32 = ALIGN(height, 32) / 32;
+
+	return SZ_4K * width_64 * height_32;
+}
+EXPORT_SYMBOL_GPL(amvdec_am21c_body_size);
+
+/* 32 bytes per 128x64 block */
+u32 amvdec_am21c_head_size(u32 width, u32 height)
+{
+	u32 width_128 = ALIGN(width, 128) / 128;
+	u32 height_64 = ALIGN(height, 64) / 64;
+
+	return 32 * width_128 * height_64;
+}
+EXPORT_SYMBOL_GPL(amvdec_am21c_head_size);
+
+u32 amvdec_am21c_size(u32 width, u32 height)
+{
+	return ALIGN(amvdec_am21c_body_size(width, height) +
+		     amvdec_am21c_head_size(width, height), SZ_64K);
+}
+EXPORT_SYMBOL_GPL(amvdec_am21c_size);
+
+static int canvas_alloc(struct amvdec_session *sess, u8 *canvas_id)
+{
+	int ret;
+
+	if (sess->canvas_num >= MAX_CANVAS) {
+		dev_err(sess->core->dev, "Reached max number of canvas\n");
+		return -ENOMEM;
+	}
+
+	ret = meson_canvas_alloc(sess->core->canvas, canvas_id);
+	if (ret)
+		return ret;
+
+	sess->canvas_alloc[sess->canvas_num++] = *canvas_id;
+	return 0;
+}
+
+static int set_canvas_yuv420m(struct amvdec_session *sess,
+			      struct vb2_buffer *vb, u32 width,
+			      u32 height, u32 reg)
+{
+	struct amvdec_core *core = sess->core;
+	u8 canvas_id[NUM_CANVAS_YUV420]; /* Y U V */
+	dma_addr_t buf_paddr[NUM_CANVAS_YUV420]; /* Y U V */
+	int ret, i;
+
+	for (i = 0; i < NUM_CANVAS_YUV420; ++i) {
+		ret = canvas_alloc(sess, &canvas_id[i]);
+		if (ret)
+			return ret;
+
+		buf_paddr[i] = vb2_dma_contig_plane_dma_addr(vb, i);
+	}
+
+	/* Y plane */
+	ret = meson_canvas_config(core->canvas, canvas_id[0], buf_paddr[0],
+				  width, height, MESON_CANVAS_WRAP_NONE,
+				  MESON_CANVAS_BLKMODE_LINEAR,
+				  MESON_CANVAS_ENDIAN_SWAP64);
+	if (ret)
+		return ret;
+
+	/* U plane */
+	ret = meson_canvas_config(core->canvas, canvas_id[1], buf_paddr[1],
+				  width / 2, height / 2, MESON_CANVAS_WRAP_NONE,
+				  MESON_CANVAS_BLKMODE_LINEAR,
+				  MESON_CANVAS_ENDIAN_SWAP64);
+	if (ret)
+		return ret;
+
+	/* V plane */
+	ret = meson_canvas_config(core->canvas, canvas_id[2], buf_paddr[2],
+				  width / 2, height / 2, MESON_CANVAS_WRAP_NONE,
+				  MESON_CANVAS_BLKMODE_LINEAR,
+				  MESON_CANVAS_ENDIAN_SWAP64);
+	if (ret)
+		return ret;
+
+	amvdec_write_dos(core, reg,
+			 ((canvas_id[2]) << 16) |
+			 ((canvas_id[1]) << 8)  |
+			 (canvas_id[0]));
+
+	return 0;
+}
+
+/* The MJPEG microcode always writes planar Y/U/V (vendor vmjpeg.c
+ * programs three distinct canvases per slot in its non-NV21 path; a
+ * 2-plane NV12 table makes U and V alias and the V plane overwrites
+ * the U plane). Give U and V separate canvases on the pool slot and
+ * interleave them into NV12M at copy time (meson8b-capture.c).
+ * Layout inside the slot: Y | U (luma/4) | V (luma/4).
+ */
+static int set_canvas_mjpeg(struct amvdec_session *sess,
+			    const struct amvdec_shadow *slot, u32 width,
+			    u32 height, u32 reg)
+{
+	struct amvdec_core *core = sess->core;
+	u8 canvas_id[3]; /* Y U V */
+	int ret, i;
+
+	for (i = 0; i < 3; ++i) {
+		ret = canvas_alloc(sess, &canvas_id[i]);
+		if (ret)
+			return ret;
+	}
+
+	/* Y plane */
+	ret = meson_canvas_config(core->canvas, canvas_id[0], slot->paddr,
+				  width, height, MESON_CANVAS_WRAP_NONE,
+				  MESON_CANVAS_BLKMODE_LINEAR, 0);
+	if (ret)
+		return ret;
+
+	/* U plane */
+	ret = meson_canvas_config(core->canvas, canvas_id[1],
+				  slot->paddr + slot->luma,
+				  width / 2, height / 2,
+				  MESON_CANVAS_WRAP_NONE,
+				  MESON_CANVAS_BLKMODE_LINEAR, 0);
+	if (ret)
+		return ret;
+
+	/* V plane */
+	ret = meson_canvas_config(core->canvas, canvas_id[2],
+				  slot->paddr + slot->luma + slot->luma / 4,
+				  width / 2, height / 2,
+				  MESON_CANVAS_WRAP_NONE,
+				  MESON_CANVAS_BLKMODE_LINEAR, 0);
+	if (ret)
+		return ret;
+
+	amvdec_write_dos(core, reg,
+			 ((canvas_id[2]) << 16) |
+			 ((canvas_id[1]) << 8)  |
+			 (canvas_id[0]));
+
+	return 0;
+}
+
+/* Meson8b slots hold the firmware byte order; GX canvases swap on write. */
+static int set_canvas_nv12m(struct amvdec_session *sess,
+			    const dma_addr_t buf_paddr[NUM_CANVAS_NV12],
+			    u32 endian, u32 width, u32 height, u32 reg)
+{
+	struct amvdec_core *core = sess->core;
+	u8 canvas_id[NUM_CANVAS_NV12]; /* Y U/V */
+	int ret, i;
+
+	for (i = 0; i < NUM_CANVAS_NV12; ++i) {
+		ret = canvas_alloc(sess, &canvas_id[i]);
+		if (ret)
+			return ret;
+	}
+
+	/* Y plane */
+	ret = meson_canvas_config(core->canvas, canvas_id[0], buf_paddr[0],
+				  width, height, MESON_CANVAS_WRAP_NONE,
+				  MESON_CANVAS_BLKMODE_LINEAR,
+				  endian);
+	if (ret)
+		return ret;
+
+	/* U/V plane */
+	ret = meson_canvas_config(core->canvas, canvas_id[1], buf_paddr[1],
+				  width, height / 2, MESON_CANVAS_WRAP_NONE,
+				  MESON_CANVAS_BLKMODE_LINEAR,
+				  endian);
+	if (ret)
+		return ret;
+
+	amvdec_write_dos(core, reg,
+			 ((canvas_id[1]) << 16) |
+			 ((canvas_id[1]) << 8)  |
+			 (canvas_id[0]));
+
+	return 0;
+}
+
+/*
+ * Meson8b: point the firmware's buffer table at the frame pool. The pool
+ * holds as many slots as the stream needs (at least the format's minimum),
+ * however many CAPTURE buffers userspace allocated.
+ */
+static int amvdec_set_pool_canvases(struct amvdec_session *sess,
+				    u32 reg_base[], u32 reg_num[])
+{
+	const struct amvdec_format *fmt_out = sess->fmt_out;
+	u32 width = ALIGN(sess->width, 32);
+	u32 height = ALIGN(sess->height, 32);
+	u32 count = clamp(sess->dpb_size, fmt_out->min_buffers,
+			  fmt_out->max_buffers);
+	u32 reg_num_cur = 0, reg_base_cur = 0, i;
+	int ret;
+
+	ret = amvdec_pool_prepare(sess, count);
+	if (ret < 0)
+		return ret;
+	amvdec_pool_give_all(sess);
+
+	for (i = 0; i < count; i++) {
+		const struct amvdec_shadow *slot = amvdec_pool_slot(sess, i);
+		dma_addr_t paddr[NUM_CANVAS_NV12] = {
+			slot->paddr, slot->paddr + slot->luma
+		};
+		u32 reg;
+
+		if (!reg_base[reg_base_cur])
+			return -EINVAL;
+		reg = reg_base[reg_base_cur] + reg_num_cur * 4;
+
+		if (fmt_out->pixfmt == V4L2_PIX_FMT_MJPEG)
+			ret = set_canvas_mjpeg(sess, slot, width, height, reg);
+		else
+			ret = set_canvas_nv12m(sess, paddr, 0, width, height, reg);
+		if (ret)
+			return ret;
+
+		if (++reg_num_cur >= reg_num[reg_base_cur]) {
+			reg_base_cur++;
+			reg_num_cur = 0;
+		}
+	}
+	sess->num_dst_bufs = count;
+
+	return 0;
+}
+
+int amvdec_set_canvases(struct amvdec_session *sess,
+			u32 reg_base[], u32 reg_num[])
+{
+	struct v4l2_m2m_buffer *buf;
+	u32 pixfmt = sess->pixfmt_cap;
+	u32 width = ALIGN(sess->width, 32);
+	u32 height = ALIGN(sess->height, 32);
+	u32 reg_cur;
+	u32 reg_num_cur = 0;
+	u32 reg_base_cur = 0;
+	int i = 0;
+	int ret;
+
+	memset(sess->fw_idx_to_vb2_idx, 0xff,
+	       sizeof(sess->fw_idx_to_vb2_idx));
+
+	if (amvdec_has_pool(sess))
+		return amvdec_set_pool_canvases(sess, reg_base, reg_num);
+
+	v4l2_m2m_for_each_dst_buf(sess->m2m_ctx, buf) {
+		struct vb2_buffer *vb = &buf->vb.vb2_buf;
+		dma_addr_t paddr[NUM_CANVAS_NV12];
+
+		if (!reg_base[reg_base_cur])
+			return -EINVAL;
+
+		reg_cur = reg_base[reg_base_cur] + reg_num_cur * 4;
+
+		switch (pixfmt) {
+		case V4L2_PIX_FMT_NV12M:
+			paddr[0] = vb2_dma_contig_plane_dma_addr(vb, 0);
+			paddr[1] = vb2_dma_contig_plane_dma_addr(vb, 1);
+			ret = set_canvas_nv12m(sess, paddr,
+					       MESON_CANVAS_ENDIAN_SWAP64,
+					       width, height, reg_cur);
+			if (ret)
+				return ret;
+			break;
+		case V4L2_PIX_FMT_YUV420M:
+			ret = set_canvas_yuv420m(sess, &buf->vb.vb2_buf, width,
+						 height, reg_cur);
+			if (ret)
+				return ret;
+			break;
+		default:
+			dev_err(sess->core->dev, "Unsupported pixfmt %08X\n",
+				pixfmt);
+			return -EINVAL;
+		}
+
+		reg_num_cur++;
+		if (reg_num_cur >= reg_num[reg_base_cur]) {
+			reg_base_cur++;
+			reg_num_cur = 0;
+		}
+
+		sess->fw_idx_to_vb2_idx[i++] = buf->vb.vb2_buf.index;
+	}
+
+	return 0;
+}
+EXPORT_SYMBOL_GPL(amvdec_set_canvases);
+
+int amvdec_add_ts(struct amvdec_session *sess, u64 ts,
+		  struct v4l2_timecode tc, u32 offset, u32 vbuf_flags)
+{
+	struct amvdec_timestamp *new_ts;
+	unsigned long flags;
+
+	new_ts = kzalloc(sizeof(*new_ts), GFP_KERNEL);
+	if (!new_ts)
+		return -ENOMEM;
+
+	new_ts->ts = ts;
+	new_ts->tc = tc;
+	new_ts->offset = offset;
+	new_ts->flags = vbuf_flags;
+
+	spin_lock_irqsave(&sess->ts_spinlock, flags);
+	list_add_tail(&new_ts->list, &sess->timestamps);
+	spin_unlock_irqrestore(&sess->ts_spinlock, flags);
+	return 0;
+}
+EXPORT_SYMBOL_GPL(amvdec_add_ts);
+
+void amvdec_remove_ts(struct amvdec_session *sess, u64 ts)
+{
+	struct amvdec_timestamp *tmp;
+	unsigned long flags;
+
+	spin_lock_irqsave(&sess->ts_spinlock, flags);
+	list_for_each_entry(tmp, &sess->timestamps, list) {
+		if (tmp->ts == ts) {
+			list_del(&tmp->list);
+			kfree(tmp);
+			goto unlock;
+		}
+	}
+	dev_warn(sess->core->dev_dec,
+		 "Couldn't remove buffer with timestamp %llu from list\n", ts);
+
+unlock:
+	spin_unlock_irqrestore(&sess->ts_spinlock, flags);
+}
+EXPORT_SYMBOL_GPL(amvdec_remove_ts);
+
+/*
+ * End of stream and resolution change mark the picture that finishes them.
+ * Decided when the decoder finishes the picture, applied when it reaches a
+ * CAPTURE buffer, which with a frame pool can be later.
+ */
+static void amvdec_mark_picture(struct amvdec_session *sess,
+				struct amvdec_picture *pic)
+{
+	struct device *dev = sess->core->dev_dec;
+
+	/* Delivery may come after a source change; keep what it decoded at. */
+	pic->geo.width = sess->width;
+	pic->geo.height = sess->height;
+	pic->geo.reference_width = sess->reference_width;
+	pic->geo.reference_height = sess->reference_height;
+	pic->geo.crop_left = sess->crop_left;
+	pic->geo.crop_top = sess->crop_top;
+
+	/* Custom drains finish only after the firmware's delayed pictures. */
+	if (sess->should_stop && !sess->fmt_out->codec_ops->drain &&
+	    atomic_read(&sess->esparser_queued_bufs) <= 1) {
+		dev_dbg(dev, "Signaling EOS\n");
+		pic->eos = true;
+		pic->flags |= V4L2_BUF_FLAG_LAST;
+	} else if (sess->status == STATUS_NEEDS_RESUME) {
+		/* Mark LAST for drained show frames during a source change */
+		pic->flags |= V4L2_BUF_FLAG_LAST;
+		pic->restart = true;
+	} else if (sess->should_stop) {
+		dev_dbg(dev, "should_stop, %u bufs remain\n",
+			atomic_read(&sess->esparser_queued_bufs));
+	}
+}
+
+/* Take the oldest queued timestamp; false when none is left. */
+static bool amvdec_take_oldest_ts(struct amvdec_session *sess,
+				  struct amvdec_picture *pic)
+{
+	struct amvdec_timestamp *tmp;
+	unsigned long flags;
+
+	spin_lock_irqsave(&sess->ts_spinlock, flags);
+	if (list_empty(&sess->timestamps)) {
+		spin_unlock_irqrestore(&sess->ts_spinlock, flags);
+		return false;
+	}
+	tmp = list_first_entry(&sess->timestamps, struct amvdec_timestamp, list);
+	pic->timestamp = tmp->ts;
+	pic->timecode = tmp->tc;
+	pic->flags = tmp->flags;
+	list_del(&tmp->list);
+	kfree(tmp);
+	spin_unlock_irqrestore(&sess->ts_spinlock, flags);
+	return true;
+}
+
+/* Take the timestamp of the packet at @offset; false when none matches. */
+static bool amvdec_take_offset_ts(struct amvdec_session *sess, u32 offset,
+				  struct amvdec_picture *pic)
+{
+	struct amvdec_timestamp *match = NULL;
+	struct amvdec_timestamp *tmp, *n;
+	unsigned long flags;
+
+	spin_lock_irqsave(&sess->ts_spinlock, flags);
+
+	/* Look for our vififo offset to get the corresponding timestamp. */
+	list_for_each_entry_safe(tmp, n, &sess->timestamps, list) {
+		if (tmp->offset > offset) {
+			/*
+			 * Delete any record that remained unused for 32 match
+			 * checks
+			 */
+			if (tmp->used_count++ >= 32) {
+				list_del(&tmp->list);
+				kfree(tmp);
+			}
+			break;
+		}
+
+		match = tmp;
+	}
+
+	if (match) {
+		pic->timestamp = match->ts;
+		pic->timecode = match->tc;
+		pic->flags = match->flags;
+		list_del(&match->list);
+		kfree(match);
+	}
+	spin_unlock_irqrestore(&sess->ts_spinlock, flags);
+	return match;
+}
+
+static void dst_buf_done(struct amvdec_session *sess,
+			 struct vb2_v4l2_buffer *vbuf,
+			 const struct amvdec_picture *pic)
+{
+	struct device *dev = sess->core->dev_dec;
+	u32 output_size = amvdec_get_output_size(sess);
+
+	switch (sess->pixfmt_cap) {
+	case V4L2_PIX_FMT_NV12M:
+		vbuf->vb2_buf.planes[0].bytesused = output_size;
+		vbuf->vb2_buf.planes[1].bytesused = output_size / 2;
+		break;
+	case V4L2_PIX_FMT_YUV420M:
+		vbuf->vb2_buf.planes[0].bytesused = output_size;
+		vbuf->vb2_buf.planes[1].bytesused = output_size / 4;
+		vbuf->vb2_buf.planes[2].bytesused = output_size / 4;
+		break;
+	}
+
+	vbuf->vb2_buf.timestamp = pic->timestamp;
+	vbuf->sequence = sess->sequence_cap++;
+	vbuf->flags = pic->flags;
+	vbuf->timecode = pic->timecode;
+	container_of(vbuf, struct amvdec_vb2_buffer, vb)->eos = pic->eos;
+	if (pic->restart)
+		sess->sequence_cap = 0;
+
+	dev_dbg(dev, "Buffer %u done, ts = %llu, flags = %08X\n",
+		vbuf->vb2_buf.index, pic->timestamp, pic->flags);
+	vbuf->field = pic->field;
+	v4l2_m2m_buf_done(vbuf, VB2_BUF_STATE_DONE);
+
+	/* Buffer done probably means the vififo got freed */
+	schedule_work(&sess->esparser_queue_work);
+}
+
+void amvdec_dst_buf_done(struct amvdec_session *sess,
+			 struct vb2_v4l2_buffer *vbuf, u32 field)
+{
+	struct amvdec_picture pic = { .field = field };
+
+	if (!amvdec_take_oldest_ts(sess, &pic)) {
+		dev_err(sess->core->dev_dec, "Buffer %u done but list is empty\n",
+			vbuf->vb2_buf.index);
+		v4l2_m2m_buf_done(vbuf, VB2_BUF_STATE_ERROR);
+		return;
+	}
+
+	amvdec_mark_picture(sess, &pic);
+	dst_buf_done(sess, vbuf, &pic);
+	atomic_dec(&sess->esparser_queued_bufs);
+}
+EXPORT_SYMBOL_GPL(amvdec_dst_buf_done);
+
+bool amvdec_timestamp_for_offset(struct amvdec_session *sess, u32 offset, u64 *timestamp)
+{
+	struct amvdec_timestamp *entry;
+	unsigned long flags;
+	bool found = false;
+
+	spin_lock_irqsave(&sess->ts_spinlock, flags);
+	list_for_each_entry(entry, &sess->timestamps, list) {
+		if (entry->offset > offset)
+			break;
+		*timestamp = entry->ts;
+		found = true;
+	}
+	spin_unlock_irqrestore(&sess->ts_spinlock, flags);
+	return found;
+}
+
+void amvdec_dst_buf_done_offset(struct amvdec_session *sess,
+				struct vb2_v4l2_buffer *vbuf,
+				u32 offset, u32 field, bool allow_drop)
+{
+	struct amvdec_picture pic = { .field = field };
+	bool matched = amvdec_take_offset_ts(sess, offset, &pic);
+
+	if (!matched)
+		dev_err(sess->core->dev_dec,
+			"Buffer %u done but can't match offset (%08X)\n",
+			vbuf->vb2_buf.index, offset);
+
+	amvdec_mark_picture(sess, &pic);
+	dst_buf_done(sess, vbuf, &pic);
+	if (matched)
+		atomic_dec(&sess->esparser_queued_bufs);
+}
+EXPORT_SYMBOL_GPL(amvdec_dst_buf_done_offset);
+
+void amvdec_pool_picture_done(struct amvdec_session *sess, u32 slot,
+			      u32 offset, u32 field)
+{
+	struct amvdec_picture pic = { .field = field };
+	bool matched;
+
+	if (offset == -1)
+		matched = amvdec_take_oldest_ts(sess, &pic);
+	else
+		matched = amvdec_take_offset_ts(sess, offset, &pic);
+	if (!matched)
+		dev_err(sess->core->dev_dec,
+			"Picture in slot %u done but can't match offset (%08X)\n",
+			slot, offset);
+
+	amvdec_mark_picture(sess, &pic);
+	amvdec_pool_push(sess, slot, &pic);
+	if (matched)
+		atomic_dec(&sess->esparser_queued_bufs);
+
+	/* A finished picture probably means the vififo got freed */
+	schedule_work(&sess->esparser_queue_work);
+}
+EXPORT_SYMBOL_GPL(amvdec_pool_picture_done);
+
+void amvdec_dst_buf_done_idx(struct amvdec_session *sess,
+			     u32 buf_idx, u32 offset, u32 field)
+{
+	struct vb2_v4l2_buffer *vbuf;
+	struct device *dev = sess->core->dev_dec;
+
+	if (amvdec_has_pool(sess)) {
+		if (buf_idx >= amvdec_pool_count(sess)) {
+			amvdec_abort(sess);
+			return;
+		}
+		amvdec_pool_picture_done(sess, buf_idx, offset, field);
+		return;
+	}
+
+	if (buf_idx >= ARRAY_SIZE(sess->fw_idx_to_vb2_idx) ||
+	    sess->fw_idx_to_vb2_idx[buf_idx] >= 32) {
+		amvdec_abort(sess);
+		return;
+	}
+
+	vbuf = v4l2_m2m_dst_buf_remove_by_idx(sess->m2m_ctx,
+					      sess->fw_idx_to_vb2_idx[buf_idx]);
+
+	if (!vbuf) {
+		dev_err(dev,
+			"Buffer %u done but it doesn't exist in m2m_ctx\n",
+			buf_idx);
+		return;
+	}
+
+	if (offset != -1)
+		amvdec_dst_buf_done_offset(sess, vbuf, offset, field, true);
+	else
+		amvdec_dst_buf_done(sess, vbuf, field);
+}
+EXPORT_SYMBOL_GPL(amvdec_dst_buf_done_idx);
+
+/* Return every still-queued capture buffer to userspace as an empty frame,
+ * marking the last with V4L2_BUF_FLAG_LAST and raising the EOS event.
+ * Needed by firmware that never completes the final picture of a stream:
+ * the m8 mpeg12 firmware emits a picture only once the next one starts,
+ * so the m2m drain would otherwise hang forever on the last frame.
+ */
+void amvdec_flush_capture_buffers(struct amvdec_session *sess)
+{
+	struct vb2_v4l2_buffer *vbuf, *last = NULL;
+	unsigned int i;
+
+	/* Pictures still waiting for a buffer come first. */
+	if (amvdec_has_pool(sess)) {
+		amvdec_pool_end(sess, AMVDEC_POOL_FLUSH);
+		return;
+	}
+
+	while ((vbuf = v4l2_m2m_dst_buf_remove(sess->m2m_ctx))) {
+		for (i = 0; i < vbuf->vb2_buf.num_planes; i++)
+			vbuf->vb2_buf.planes[i].bytesused = 0;
+		vbuf->field = V4L2_FIELD_NONE;
+		if (last)
+			v4l2_m2m_buf_done(last, VB2_BUF_STATE_DONE);
+		last = vbuf;
+	}
+
+	if (!last)
+		return;
+
+	last->flags = V4L2_BUF_FLAG_LAST;
+	container_of(last, struct amvdec_vb2_buffer, vb)->eos = true;
+	v4l2_m2m_buf_done(last, VB2_BUF_STATE_DONE);
+}
+EXPORT_SYMBOL_GPL(amvdec_flush_capture_buffers);
+
+void amvdec_set_par_from_dar(struct amvdec_session *sess,
+			     u32 dar_num, u32 dar_den)
+{
+	u32 div;
+
+	sess->pixelaspect.numerator = sess->height * dar_num;
+	sess->pixelaspect.denominator = sess->width * dar_den;
+	div = gcd(sess->pixelaspect.numerator, sess->pixelaspect.denominator);
+	sess->pixelaspect.numerator /= div;
+	sess->pixelaspect.denominator /= div;
+}
+EXPORT_SYMBOL_GPL(amvdec_set_par_from_dar);
+
+void amvdec_src_change(struct amvdec_session *sess, u32 width,
+		       u32 height, u32 dpb_size)
+{
+	static const struct v4l2_event ev = {
+		.type = V4L2_EVENT_SOURCE_CHANGE,
+		.u.src_change.changes = V4L2_EVENT_SRC_CH_RESOLUTION };
+
+	sess->dpb_size = dpb_size;
+	/* With a frame pool the CAPTURE buffers only receive copies: any
+	 * number of them works, and the pool follows the DPB size by itself.
+	 */
+	if (!amvdec_has_pool(sess))
+		v4l2_ctrl_s_ctrl(sess->ctrl_min_buf_capture, dpb_size);
+
+	/*
+	 * Check if the capture queue is already configured well for our
+	 * usecase. If so, keep decoding with it and do not send the event
+	 */
+	if (sess->streamon_cap &&
+	    sess->width == width &&
+	    sess->height == height &&
+	    (amvdec_has_pool(sess) || dpb_size <= sess->num_dst_bufs)) {
+		sess->fmt_out->codec_ops->resume(sess);
+		return;
+	}
+
+	sess->width = width;
+	sess->height = height;
+	sess->status = STATUS_NEEDS_RESUME;
+
+	dev_dbg(sess->core->dev, "Res. changed (%ux%u), DPB size %u\n",
+		width, height, dpb_size);
+	v4l2_event_queue_fh(&sess->fh, &ev);
+}
+EXPORT_SYMBOL_GPL(amvdec_src_change);
+
+void amvdec_abort(struct amvdec_session *sess)
+{
+	dev_info(sess->core->dev, "Aborting decoding session!\n");
+	WRITE_ONCE(sess->should_stop, 1);
+	vb2_queue_error(&sess->m2m_ctx->cap_q_ctx.q);
+	vb2_queue_error(&sess->m2m_ctx->out_q_ctx.q);
+}
+EXPORT_SYMBOL_GPL(amvdec_abort);
