+static int v4l2_prepare_rate_limit(V4L2m2mContext *s)
+{
+    AVCodecContext *avctx = s->avctx;
+    V4L2m2mPriv *priv = avctx->priv_data;
+    struct v4l2_ext_control controls[4] = { 0 };
+    struct v4l2_ext_controls config = { 0 };
+    int64_t cpb_kbytes = avctx->rc_buffer_size / (8 * 1024);
+    int ret;
+
+    if (!priv->rate_limit)
+        return 0;
+    if (avctx->codec_id != AV_CODEC_ID_H264 || avctx->bit_rate <= 0 ||
+        avctx->rc_max_rate < avctx->bit_rate || avctx->rc_max_rate > INT_MAX ||
+        cpb_kbytes <= 0 || cpb_kbytes > INT_MAX) {
+        av_log(avctx, AV_LOG_ERROR, "V4L2 rate limits require H.264, positive bitrate/bufsize and maxrate >= bitrate\n");
+        return AVERROR(EINVAL);
+    }
+    controls[0].id = MPEG_CID(BITRATE_MODE);
+    controls[0].value = V4L2_MPEG_VIDEO_BITRATE_MODE_VBR;
+    controls[1].id = MPEG_CID(BITRATE);
+    controls[1].value = avctx->bit_rate;
+    controls[2].id = MPEG_CID(BITRATE_PEAK);
+    controls[2].value = avctx->rc_max_rate;
+    controls[3].id = MPEG_CID(H264_CPB_SIZE);
+    controls[3].value = cpb_kbytes;
+    config.ctrl_class = V4L2_CTRL_CLASS_MPEG;
+    config.count = FF_ARRAY_ELEMS(controls);
+    config.controls = controls;
+    ret = ioctl(s->fd, VIDIOC_S_EXT_CTRLS, &config);
+    if (ret < 0) {
+        av_log(avctx, AV_LOG_ERROR, "Device rejected required V4L2 peak/CPB controls: %s\n", av_err2str(AVERROR(errno)));
+        return AVERROR(errno);
+    }
+    av_log(avctx, AV_LOG_INFO, "V4L2 rate limits: peak=%"PRId64" bps, CPB=%"PRId64" KiB\n",
+           avctx->rc_max_rate, cpb_kbytes);
+    return 0;
+}
