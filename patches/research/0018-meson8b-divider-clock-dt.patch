Subject: [PATCH RFC] media: meson: Pass the Meson8b VDEC1 divider to the decoder

An explicit divider handle avoids deriving clock topology from a fixed
number of parent links. The decoder refuses rates that would require
retuning a shared PLL. No clock is changed at probe time.

---
diff --git a/arch/arm/boot/dts/amlogic/meson8b.dtsi b/arch/arm/boot/dts/amlogic/meson8b.dtsi
--- a/arch/arm/boot/dts/amlogic/meson8b.dtsi
+++ b/arch/arm/boot/dts/amlogic/meson8b.dtsi
@@ -28,8 +28,8 @@
 				     <GIC_SPI 32 IRQ_TYPE_EDGE_RISING>;
 			interrupt-names = "vdec", "esparser";
 			clocks = <&clkc CLKID_DOS_PARSER>, <&clkc CLKID_DOS>,
-				 <&clkc CLKID_VDEC_1>;
-			clock-names = "dos_parser", "dos", "vdec_1";
+				 <&clkc CLKID_VDEC_1>, <&clkc CLKID_VDEC_1_1_DIV>;
+			clock-names = "dos_parser", "dos", "vdec_1", "vdec_1_div";
 			resets = <&reset RESET_PARSER>;
 			reset-names = "esparser";
 			amlogic,dos = <&dos>;
