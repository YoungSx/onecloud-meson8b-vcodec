Subject: [PATCH RFC] media: meson: distinguish legacy submission counts from activity

A submitted OUTPUT buffer need not produce one picture. Bound the drain
wait, fail continuous IRQ activity, and keep the existing quiet-firmware
flush for retained legacy tails. Do not turn known tail omissions into
a new queue failure merely because submission accounting is nonzero.

---
diff --git a/drivers/staging/media/meson/vdec/codec_mpeg12.c b/drivers/staging/media/meson/vdec/codec_mpeg12.c
--- a/drivers/staging/media/meson/vdec/codec_mpeg12.c
+++ b/drivers/staging/media/meson/vdec/codec_mpeg12.c
@@ -184,9 +184,10 @@
 	struct amvdec_session *sess = mpeg12->sess;
 	static const u32 max_polls = 150; /* 3 s at 20 ms */
 	u32 polls = 0;
+	bool irq_quiet = false;
 
 	while (polls++ < max_polls) {
-		bool irq_quiet = !READ_ONCE(sess->irq_active) &&
+		irq_quiet = !READ_ONCE(sess->irq_active) &&
 			!time_is_after_jiffies64(
 			READ_ONCE(sess->last_irq_jiffies) + msecs_to_jiffies(100));
 		int in_flight = atomic_read(&sess->esparser_queued_bufs);
@@ -198,7 +199,8 @@
 	}
 
 	mpeg12->draining = false;
-	if (polls > max_polls) {
+	/* Submission count is not a picture count for legacy firmware. */
+	if (!irq_quiet) {
 		amvdec_abort(sess);
 		return;
 	}
