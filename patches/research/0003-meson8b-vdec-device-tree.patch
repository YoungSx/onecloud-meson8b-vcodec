Subject: [PATCH 3/3 RFC] ARM: dts: describe Meson8b VDEC and enable on ODROID-C1

Use the S805 DOS aperture at 0xd0050000, parser at 0xc110a580,
interrupts 44/32 and the existing clock, reset and canvas providers.
The SoC node is disabled by default; ODROID-C1 enables it as a lab device.
The accompanying driver refuses streaming until capture conversion exists.

Rebased onto v7.3.4: mainline has no meson8b-onecloud.dts, so the enable
hunk targets meson8b-odroidc1.dts and the node lives under /soc to match
how the GX VDEC node is declared. Meson8b needs no vdec_hevc clock.

---
diff --git a/arch/arm/boot/dts/amlogic/meson8b-odroidc1.dts b/arch/arm/boot/dts/amlogic/meson8b-odroidc1.dts
index 1cd2093..bfd0ea5 100644
--- a/arch/arm/boot/dts/amlogic/meson8b-odroidc1.dts
+++ b/arch/arm/boot/dts/amlogic/meson8b-odroidc1.dts
@@ -379,3 +379,7 @@
 		reset-gpios = <&gpio_ao GPIOAO_4 GPIO_ACTIVE_LOW>;
 	};
 };
+
+&vdec {
+	status = "okay";
+};
diff --git a/arch/arm/boot/dts/amlogic/meson8b.dtsi b/arch/arm/boot/dts/amlogic/meson8b.dtsi
index 2d77b98..4ded8eb 100644
--- a/arch/arm/boot/dts/amlogic/meson8b.dtsi
+++ b/arch/arm/boot/dts/amlogic/meson8b.dtsi
@@ -14,6 +14,25 @@
 #include "meson.dtsi"
 
 / {
+	soc {
+		vdec: video-codec@d0050000 {
+			compatible = "amlogic,meson8b-vdec";
+			reg = <0xd0050000 0x10000>, <0xc110a580 0xe4>;
+			reg-names = "dos", "esparser";
+			interrupts = <GIC_SPI 44 IRQ_TYPE_EDGE_RISING>,
+				     <GIC_SPI 32 IRQ_TYPE_EDGE_RISING>;
+			interrupt-names = "vdec", "esparser";
+			clocks = <&clkc CLKID_DOS_PARSER>, <&clkc CLKID_DOS>,
+				 <&clkc CLKID_VDEC_1>;
+			clock-names = "dos_parser", "dos", "vdec_1";
+			resets = <&reset RESET_PARSER>;
+			reset-names = "esparser";
+			amlogic,ao-sysctrl = <&pmu>;
+			amlogic,canvas = <&canvas>;
+			status = "disabled";
+		};
+	};
+
 	cpus {
 		#address-cells = <1>;
 		#size-cells = <0>;
